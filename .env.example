# How this server reaches Sure. Inside Sure's compose network: http://web:3000
SURE_URL=https://sure.example.org
# Where browsers reach Sure (sign-in). Defaults to SURE_URL.
# SURE_PUBLIC_URL=https://sure.example.org
# Where browsers reach this UI; its path is the prefix it is served under. Users sign in with their Sure account.
SPE_PUBLIC_URL=http://127.0.0.1:8790
# Seals Sure tokens, provider logins and cookies at rest. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SPE_SECRET_KEY=
# Default inside Docker: sqlite:////data/spe.db. Postgres: postgresql+psycopg://user:pass@host/db
# DATABASE_URL=
# SPE_LISTEN=127.0.0.1:8790
# Provider logins of users Sure stopped accepting (revoked, removed) are erased after this many days.
# SPE_DISCONNECTED_WIPE_DAYS=30
# Keep every Esselunga receipt PDF here (first sync backfills what the site still lists). Docker: /receipts volume.
# SPE_RECEIPTS_DIR=
